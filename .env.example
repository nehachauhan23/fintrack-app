# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"
# Optional: direct (non-pooled) URL used only by `prisma migrate` (Neon/Supabase/PgBouncer).
# DIRECT_URL=""

# ── App ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
SESSION_TTL_DAYS=30

# ── AI (OpenRouter) ────────────────────────────────────────────────────────
# Free key: https://openrouter.ai/keys  (no card needed)
OPENROUTER_API_KEY=""
# Comma-separated, in priority order, max 3 (OpenRouter fallback limit). Free models rotate often:
# run `npm run ai:models` to see what is currently free.
OPENROUTER_MODELS="openai/gpt-oss-120b:free,google/gemma-4-31b-it:free,openrouter/free"
# Must accept image input (used for receipt scanning).
OPENROUTER_VISION_MODELS="google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free"
# "deny" only routes to providers that do not retain/train on prompts (recommended for financial data).
# Free models are sometimes only available from providers that DO log prompts; if every request
# fails with a data-policy error, either add credits and use a paid model, or set this to "allow".
OPENROUTER_DATA_COLLECTION="deny"
# Free tier = 20 req/min and 50 req/day (1000/day after a one-time $10 credit purchase).
AI_USER_DAILY_LIMIT=20   # 0 = unlimited
AI_GLOBAL_DAILY_LIMIT=45 # 0 = unlimited (set 0 once you have paid credits)
AI_TIMEOUT_MS=45000

# ── Email (optional; emails are logged to the console when unset) ──────────
RESEND_API_KEY=""
EMAIL_FROM="FinTrack <onboarding@resend.dev>"

# ── Background jobs (Inngest; not needed for local dev without the dev server) ─
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
